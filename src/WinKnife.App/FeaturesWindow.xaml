<Window x:Class="WinKnife.App.FeaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKnife - Features"
        Width="1000" Height="660" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/winknife.ico"
        Style="{DynamicResource WK.WindowStyle}">
    <!-- SPDX-License-Identifier: GPL-3.0-or-later -->
    <!-- WinKnife — Windows port of Vorssaint (https://github.com/vorssaint/vorssaint-utils) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Feature list -->
        <DockPanel Grid.Column="0" Margin="16,16,8,16">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" Padding="8,6" TextChanged="OnSearchChanged" />
                <TextBlock x:Name="SearchPlaceholder" Text="Search features" IsHitTestVisible="False" Margin="11,0,0,0"
                           VerticalAlignment="Center" Style="{DynamicResource WK.MutedTextStyle}" />
            </Grid>
            <ListBox x:Name="FeatureList" BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="6,14,0,4" FontWeight="SemiBold"
                                           Style="{DynamicResource WK.MutedTextStyle}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <CheckBox Grid.Column="1" Style="{DynamicResource WK.SwitchStyle}"
                                      IsChecked="{Binding IsInstalled, Mode=TwoWay}"
                                      ToolTip="Install or uninstall this feature" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Details -->
        <Border Grid.Column="1" Margin="8,16,16,16" Style="{DynamicResource WK.CardStyle}" Padding="0">
            <Grid>
                <TextBlock x:Name="EmptyHint" Text="Select a feature to see its details."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{DynamicResource WK.MutedTextStyle}" />
                <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="24">
                        <TextBlock x:Name="DetailName" Style="{DynamicResource WK.TitleTextStyle}" />
                        <TextBlock x:Name="DetailGroup" Margin="0,2,0,0" Style="{DynamicResource WK.MutedTextStyle}" />
                        <TextBlock x:Name="DetailDescription" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailNotice" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Style="{DynamicResource WK.MutedTextStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="InstallButton" Style="{DynamicResource WK.AccentButtonStyle}"
                                    Click="OnInstallClick" MinWidth="110" />
                            <TextBlock x:Name="DetailStatus" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Style="{DynamicResource WK.MutedTextStyle}" />
                        </StackPanel>
                        <Separator Margin="0,20,0,16" />
                        <TextBlock Text="Settings" Style="{DynamicResource WK.SubtitleTextStyle}" Margin="0,0,0,10" />
                        <TextBlock x:Name="SettingsHint" Style="{DynamicResource WK.MutedTextStyle}" />
                        <ContentControl x:Name="SettingsHost" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
