<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Trayloom.App</RootNamespace>
    <AssemblyName>Trayloom</AssemblyName>
    <!-- WFO0003: the manifest is the DPI source of truth required by the spec (PerMonitorV2). -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\trayloom.ico</ApplicationIcon>
    <StartupObject>Trayloom.App.Program</StartupObject>
    <!-- A tray app: workstation, non-concurrent GC keeps the idle footprint and thread count down. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- App.xaml is a Page, not the ApplicationDefinition: Program.cs is the entry point (the generated Main would load WPF for every start). -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\trayloom.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trayloom.Core\Trayloom.Core.csproj" />
    <ProjectReference Include="..\Trayloom.Features.Input\Trayloom.Features.Input.csproj" />
    <ProjectReference Include="..\Trayloom.Features.Windows\Trayloom.Features.Windows.csproj" />
    <ProjectReference Include="..\Trayloom.Features.System\Trayloom.Features.System.csproj" />
    <ProjectReference Include="..\Trayloom.Features.Tools\Trayloom.Features.Tools.csproj" />
    <ProjectReference Include="..\Trayloom.Features.Island\Trayloom.Features.Island.csproj" />
    <ProjectReference Include="..\Trayloom.Features.Capture\Trayloom.Features.Capture.csproj" />
    <ProjectReference Include="..\Trayloom.Features.Agents\Trayloom.Features.Agents.csproj" />
    <ProjectReference Include="..\Trayloom.Features.Files\Trayloom.Features.Files.csproj" />
    <ProjectReference Include="..\Trayloom.Features.Maintenance\Trayloom.Features.Maintenance.csproj" />
  </ItemGroup>
</Project>
