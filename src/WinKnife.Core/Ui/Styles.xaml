<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SPDX-License-Identifier: GPL-3.0-or-later -->
    <!-- WinKnife — Windows port of Vorssaint (https://github.com/vorssaint/vorssaint-utils) -->
    <!-- Brushes (WK.*) are provided by ThemeManager and swapped for light/dark. -->

    <Style x:Key="WK.WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WK.WindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="WK.CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WK.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WK.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="WK.TitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WK.SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WK.MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WK.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WK.IconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Toggle switch look for a CheckBox. -->
    <Style x:Key="WK.SwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="11" BorderThickness="1"
                                    Background="{DynamicResource WK.SwitchOff}"
                                    BorderBrush="{DynamicResource WK.Border}" />
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="4,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource WK.TextMuted}" />
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource WK.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource WK.Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource WK.AccentText}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square tile button used by the quick panel. -->
    <Style x:Key="WK.TileStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="88" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="10" BorderThickness="1"
                            Background="{DynamicResource WK.Surface}"
                            BorderBrush="{DynamicResource WK.Border}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource WK.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary (accent coloured) button. -->
    <Style x:Key="WK.AccentButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WK.AccentText}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="6" Background="{DynamicResource WK.Accent}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
