<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SPDX-License-Identifier: GPL-3.0-or-later -->
    <!-- Trayloom — Windows port of Vorssaint (https://github.com/vorssaint/vorssaint-utils) -->
    <!-- Brushes (WK.*) are provided by ThemeManager and swapped for light/dark. -->

    <Style x:Key="WK.WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WK.WindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="WK.CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WK.Settings.Card}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="WK.TitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WK.SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WK.MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WK.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WK.IconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Accent ring drawn around a focused border-based control (see UiKit.Clickable). -->
    <Style x:Key="WK.FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource WK.Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mac-style switch (regular 40x22). Small = 34x18, Mini = 28x15. Track on = accent, thumb white. -->
    <Style x:Key="WK.SwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource WK.FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource WK.SwitchOff}" />
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="2" HorizontalAlignment="Left" Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.28" />
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbMove" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource WK.Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WK.SwitchSmallStyle" TargetType="CheckBox" BasedOn="{StaticResource WK.SwitchStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="34" Height="19" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="9.5" Background="{DynamicResource WK.SwitchOff}" />
                            <Ellipse x:Name="Thumb" Width="15" Height="15" Margin="2" HorizontalAlignment="Left" Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.28" />
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbMove" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource WK.Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WK.SwitchMiniStyle" TargetType="CheckBox" BasedOn="{StaticResource WK.SwitchStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="28" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="8" Background="{DynamicResource WK.SwitchOff}" />
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="2" HorizontalAlignment="Left" Fill="White">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbMove" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource WK.Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square tile button (legacy v1 quick panel). -->
    <Style x:Key="WK.TileStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text}" />
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="88" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="10" BorderThickness="1"
                            Background="{DynamicResource WK.Surface}"
                            BorderBrush="{DynamicResource WK.Border}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource WK.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons: bordered (flat grey), prominent (accent), plain (hover only), destructive (red). -->
    <Style x:Key="WK.Button.Bordered" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource WK.Settings.Control}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" />
                        <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource WK.Row.Hover}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WK.Button.Prominent" TargetType="Button" BasedOn="{StaticResource WK.Button.Bordered}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource WK.Accent}" />
    </Style>

    <Style x:Key="WK.AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource WK.Button.Prominent}">
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="WK.Button.Destructive" TargetType="Button" BasedOn="{StaticResource WK.Button.Bordered}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource WK.Red}" />
    </Style>

    <Style x:Key="WK.Button.Plain" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource WK.Row.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded text box (search fields, URL fields...). -->
    <Style x:Key="WK.TextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource WK.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource WK.Settings.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WK.Card.Border}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SelectionBrush" Value="{DynamicResource WK.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource WK.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shortcut recorder: a small button-like field (width 108 in Vorssaint). -->
    <Style x:Key="WK.HotkeyRecorderStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource WK.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource WK.Settings.Control}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="1.2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource WK.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource WK.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Pop-up menus. The stock Windows template draws a light icon gutter down the left edge, which shows as a white block
         over dark menus. Every ContextMenu / MenuItem in the app uses these instead; a menu may still set its own colours. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource WK.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WK.Card.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource WK.Text.Primary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource WK.Divider}" />
        <Setter Property="Margin" Value="8,4,8,4" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Padding" Value="6,5,10,5" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="WKMenuGesture" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Width="16" Height="16" />
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="18,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource WK.Text.Secondary}" />
                                <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-5" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{DynamicResource WK.Surface}"
                                    BorderBrush="{DynamicResource WK.Card.Border}" BorderThickness="1" CornerRadius="8" Padding="4"
                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WK.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource WK.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
